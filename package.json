{
  "name": "ambient-sound-mixer",
  "productName": "Ambient Sound Mixer",
  "version": "0.1.0",
  "private": true,
  "description": "Mix ambient sounds from YouTube — rain, cafe, forest, waves — with per-sound volume and a sleep timer.",
  "author": "Piecez2548",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,electron \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "local.ambient-sound-mixer",
    "productName": "Ambient Sound Mixer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Ambient-Sound-Mixer-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
